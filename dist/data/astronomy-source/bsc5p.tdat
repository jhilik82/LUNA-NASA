table_name = heasarc_bsc5p
table_description = "Bright Star Catalog"
table_document_url = http://heasarc.gsfc.nasa.gov/W3Browse/star-catalog/bsc5p.html
table_security = public
#
# Table Parameters
#
field[ads] = char6  [meta.id.cross] (index) // ADS Catalog Designation
field[ads_comp] = char2  [meta.id.cross] (index) // ADS Letter Identification
field[alt_name] = char16  [meta.id] (index) // Alternate Name (usually Bayer and/or Flamsteed)
field[bii] = float4:.5f_degree [pos.galactic.lat] (index) // Galactic Latitude
field[bv_color] = float4:.2f  [phot.color;em.opt.B;em.opt.V] (index) // B-V Color Magnitude
field[bv_uncert] = char2  [meta.code.error;phot.color;em.opt.B;em.opt.V] (index) // B-V Uncertainty Flag (:=uncertain; ?=questionable)
field[cdec] = char8  [pos.eq.dec]  // Declination, Sexagesimal, J2000
field[cdec_1950] = char8  [pos.eq.dec]  // Declination, Sexagesimal, B1950
field[class] = int2  [src.class] (index) // Browse Classification
field[cra] = char8  [pos.eq.ra]  // Right Ascension, Sexagesimal, J2000
field[cra_1950] = char8  [pos.eq.ra]  // Right Ascension, Sexagesimal, B1950
field[dec] = float8:.5f_degree [pos.eq.dec;meta.main] (key) // Declination, J2000
field[dec_1900] = float8:.5f_degree [pos.eq.dec]  // Declination, B1900
field[dec_1950] = float8:.5f_degree [pos.eq.dec] (index) // Declination, B1950
field[dm_cat] = char2  [meta.id.cross]  // Durchmusterung Catalog ID [BD/CD/CP]
field[dm_num] = char10  [meta.id.cross] (index) // Durchmusterung Number
field[fk5] = int2  [meta.id.cross] (index) // FK5 Star Number
field[glat] = float4:.2f_degree [pos.galactic.lat]  // Original Galactic Latitude
field[glon] = float4:.2f_degree [pos.galactic.lon]  // Original Galactic Longitude
field[hd] = int4  [meta.id.cross] (index) // Henry Draper Catalog Number
field[hr] = int2  [meta.id.cross] (index) // Harvard Revised BS Number
field[ir_flag] = char2  [meta.ref] (index) // Infrared Source Flag [I]
field[lii] = float4:.5f_degree [pos.galactic.lon] (index) // Galactic Longitude
field[m_cnt] = int2  [meta.number]  // Number of Components in Multiple System
field[m_id] = char4  [meta.code]  // Identification of Double or the Brightest in Multiple System
field[m_mdiff] = float4:.1f  [phot.mag;arith.diff]  // Magnitude Difference of Double or the Brightest in Multiple System
field[m_sep] = float4  [pos.angDistance]  // Separation of Components of Double or the Brightest in Multiple System
field[multiple] = char2  [meta.code.multip] (index) // Double or Multiple System Flag
field[name] = char12  [meta.id;meta.main] (index) // Source Designation
field[note] = char2  [meta.note]  // Notation Flag [*]
field[par_code] = char2  [meta.code;pos.parallax.trig] (index) // Parallax Code (D=Dynamical; Otherwise, Trigonometric)
field[parallax] = float4:.3f_arcsec [pos.parallax.trig] (index) // Parallax (arcsec)
field[pmdec] = float4:.3f_arcsec/yr [pos.pm;pos.eq.dec] (index) // Proper Motion for Dec J2000 (arcsec/yr)
field[pmra] = float4:.3f_arcsec/yr [pos.pm;pos.eq.ra] (index) // Proper Motion for RA J2000 (arcsec/yr)
field[ra] = float8:.5f_degree [pos.eq.ra;meta.main] (key) // Right Ascension, J2000
field[ra_1900] = float8:.5f_degree [pos.eq.ra]  // Right Ascension, B1900
field[ra_1950] = float8:.5f_degree [pos.eq.ra] (index) // Right Ascension, B1950
field[radvel] = int2_km/s [spect.dopplerVeloc] (index) // Radial Velocity (Line of Sight, Heliocentric)
field[radvel_comm] = char4  [meta.note;spect.dopplerVeloc]  // Radial Velocity Comments
field[ri_code] = char2  [meta.code;phot.color;em.opt.R;em.opt.I] (index) // R-I Systems Codes
field[ri_color] = float4:.2f  [phot.color;em.opt.R;em.opt.I] (index) // R-I in Systems Specified
field[rotvel] = int2_km/s [phys.veloc.rotat] (index) // Rotational Velocity
field[rotvel_comm] = char2  [meta.code.error;phys.veloc.rotat]  // Rotational Velocity Comments
field[rotvel_uncert] = char2  [meta.code.error]  // Rotational Velocity Uncertainty Flag (:=uncertain; ?=questionable)
field[sao] = int4  [meta.id.cross] (index) // SAO Catalog Number
field[spect_code] = char2  [meta.code;src.spType] (index) // Spectral Type Code
field[spect_type] = char20  [src.spType] (index) // Spectral Type of Source
field[ub_color] = float4:.2f  [phot.color;em.opt.U;em.opt.B] (index) // U-B Color Magnitude
field[ub_uncert] = char2  [meta.code.error;phot.color;em.opt.U;em.opt.B] (index) // U-B Uncertainty Flag (:=uncertain; ?=questionable)
field[var_id] = char10  [meta.id] (index) // Variable Star Identification
field[vmag] = float4:5.2f  [phot.mag;em.opt.V] (index) // Photographic Magnitude
field[vmag_code] = char2  [meta.code;phot.mag;em.opt.V] (index) // Photographic Magnitude Code
field[vmag_uncert] = char2  [meta.code;phot.mag;em.opt.V]  // Photographic Magnitude Uncertainty Flag (:=uncertain; ?=questionable)
#
parameter_defaults = name alt_name ra dec vmag multiple class
#
# Virtual Parameters
#
catalog_bibcode = <V/50/catalog>
declination = @dec
default_search_radius = 1
equinox = 2000
frequency_regime = Optical
observatory_name = STAR CATALOG
right_ascension = @ra
row_type = Star
table_author = Hoffleit, Warren
table_priority = 3
table_type = Object
target_name = @name
unique_key = hr
#
# Data Format Specification
#
line[1] = ads ads_comp alt_name bii bv_color bv_uncert cdec cdec_1950 class cra cra_1950 dec dec_1900 dec_1950 dm_cat dm_num fk5 glat glon hd hr ir_flag lii m_cnt m_id m_mdiff m_sep multiple name note par_code parallax pmdec pmra ra ra_1900 ra_1950 radvel radvel_comm ri_code ri_color rotvel rotvel_comm rotvel_uncert sao spect_code spect_type ub_color ub_uncert var_id vmag vmag_code vmag_uncert
#
