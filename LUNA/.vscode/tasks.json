{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install dependencies",
      "type": "shell",
      "command": "npm",
      "args": [
        "ci"
      ],
      "windows": {
        "command": "npm.cmd"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build game",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "build"
      ],
      "windows": {
        "command": "npm.cmd"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Start game",
      "type": "shell",
      "command": "npm",
      "args": [
        "start"
      ],
      "windows": {
        "command": "npm.cmd"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "npm",
      "args": [
        "test"
      ],
      "windows": {
        "command": "npm.cmd"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
