# Copy this file to .env. npm start works with these local defaults.
PORT=3000
LUNA_DATA_DIR=backend/data
# Optional Python executable. Leave empty to use python3 (Linux/macOS) or py -3 (Windows).
PYTHON=
NASA_CHECK_HOURS=24
# npm run data:watch checks headers daily. Enable staged refreshes after detected changes:
NASA_AUTO_REFRESH=false

# Optional Supabase cloud publishing. Use your own project and server-only legacy service_role key.
# Run backend/supabase/schema.sql in Supabase before npm run cloud:publish.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=luna-datasets
